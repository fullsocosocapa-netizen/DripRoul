-- ============================================
-- FUNÇÕES DO JOGO
-- ============================================
local function ProcessarNPC(npcRoot)
    if not Config.AutoAjoelhar then return end
    
    local meuChar = LocalPlayer.Character
    if not meuChar or not meuChar:FindFirstChild("HumanoidRootPart") then return end
    
    local npcPos = npcRoot.Position
    local npcModel = npcRoot.Parent
    
    local posicaoIdeal = CFrame.new(npcPos + Vector3.new(0, 0, 2.5), npcPos)
    meuChar.HumanoidRootPart.CFrame = posicaoIdeal
    
    local tempoGasto = 0
    while tempoGasto < Config.TempoMaximoNPC do
        if not Config.AutoAjoelhar then return end
        
        meuChar.HumanoidRootPart.CFrame = posicaoIdeal
        
        -- Tenta ProximityPrompt
        local promptEncontrado = false
        for _, prompt in ipairs(npcModel:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    prompt:InputHoldBegin()
                    task.wait(0.05)
                    prompt:InputHoldEnd()
                end)
                promptEncontrado = true
                break
            end
        end
        
        -- Clique Virtual
        if not promptEncontrado then
            local screenSize = workspace.CurrentCamera.ViewportSize
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(screenSize.X/2, screenSize.Y/2, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(screenSize.X/2, screenSize.Y/2, 0, false, game, 1)
            end)
        end
        
        task.wait(0.25) 
        tempoGasto = tempoGasto + 0.25
    end
    
    npcsAjoelhados[npcModel] = true
end

local function AjoelharAreaAtual()
    local meuChar = LocalPlayer.Character
    if not meuChar or not meuChar:FindFirstChild("HumanoidRootPart") then return end
    local minhaPos = meuChar.HumanoidRootPart.Position
    
    local npcsNaArea = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent ~= meuChar and obj.Health > 0 then
            local isPlayer = Players:GetPlayerFromCharacter(obj.Parent)
            if not isPlayer and not npcsAjoelhados[obj.Parent] then
                local root = obj.Parent:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - minhaPos).Magnitude <= 80 then
                    table.insert(npcsNaArea, root)
                end
            end
        end
    end
    
    table.sort(npcsNaArea, function(a, b)
        return (a.Position - minhaPos).Magnitude < (b.Position - minhaPos).Magnitude
    end)
    
    for _, npc in ipairs(npcsNaArea) do
        if not Config.AutoAjoelhar then break end
        ProcessarNPC(npc)
    end
end

-- ============================================
-- TELEPORTE E AUTO-WALK (LÓGICA DO SCRIPT V2)
-- ============================================
local function TeleportePara(nomeAlvo)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local nome = obj.Name:lower()
            local match = false
            
            for _, termo in ipairs(Cidades) do
                if nome:find(termo:lower()) then
                    match = true
                    break
                end
            end
            
            -- Condição específica para o Rei
            if nomeAlvo == "The King" and (nome:find("king") or nome:find("rei")) then
                match = true
            end

            if match and (obj:FindFirstChild("HumanoidRootPart") or obj:IsA("BasePart")) then
                local hrp = obj:FindFirstChild("HumanoidRootPart") or obj
                local meuChar = LocalPlayer.Character
                
                if meuChar and meuChar:FindFirstChild("HumanoidRootPart") then
                    meuChar.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 3, 5)
                    return true
                end
            end
        end
    end
    return false
end

local function IniciarAutoAjoelhar()
    if TarefaAjoelhar then task.cancel(TarefaAjoelhar) end
    
    TarefaAjoelhar = task.spawn(function()
        while Config.AutoAjoelhar do
            AjoelharAreaAtual()
            
            if Config.AutoAjoelhar and Config.AutoCidade then
                task.wait(1) 
                -- Pega uma cidade aleatória e teleporta (igual script antigo)
                local alvo = Cidades[math.random(1, #Cidades)]
                TeleportePara(alvo)
                task.wait(1.5)
            end
            task.wait(1)
        end
    end)
end

local function PararAutoAjoelhar()
    Config.AutoAjoelhar = false
    if TarefaAjoelhar then
        pcall(function() task.cancel(TarefaAjoelhar) end)
        TarefaAjoelhar = nil
    end
    npcsAjoelhados = {}
end

local function IrParaRei()
    TeleportePara("The King")
    task.wait(0.5)
    AjoelharAreaAtual()
end

