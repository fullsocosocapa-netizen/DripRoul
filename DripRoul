SubmitBtn.MouseButton1Click:Connect(function()
    if emCooldown then
        notificar("Aguarde", "Cooldown ativo.", Color3.fromRGB(255, 180, 0))
        return
    end

    local inserida = KeyBox.Text:gsub("%s+", "")
    if inserida == "" then
        notificar("Erro", "Digite uma key!", Color3.fromRGB(255, 80, 80))
        return
    end

    spinner.Visible = true
    SubmitBtn.Text = "VALIDANDO..."
    SubmitBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 120)

    task.wait(1)
    spinner.Visible = false

    if isValidKey(inserida) then
        KeyFrame.Visible = false
        Ball.Visible = true
        notificar("✅ Sucesso", "Bem-vindo ao DripRoul Hub!", Color3.fromRGB(0, 200, 130))
    else
        tentativas = tentativas + 1
        local restantes = MAX_TENTATIVAS - tentativas

        if restantes <= 0 then
            KeyFrame.Visible = false
            mostrarBloqueio("Você excedeu o número máximo de tentativas (" .. MAX_TENTATIVAS .. ").")
            notificar("🔒 Bloqueado", "Você foi bloqueado!", Color3.fromRGB(255, 60, 80))
        else
            notificar("❌ Key Incorreta", "Tentativas restantes: " .. restantes, Color3.fromRGB(255, 80, 80))
            TentativasLbl.Text = "Tentativas restantes: " .. restantes
            KeyBox.Text = ""

            emCooldown = true
            task.spawn(function()
                for i = COOLDOWN_SEGUNDOS, 1, -1 do
                    SubmitBtn.Text = "AGUARDE " .. i .. "s"
                    task.wait(1)
                end
                emCooldown = false
                SubmitBtn.Text = "CONFIRMAR"
                SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
            end)
        end
    end
end)

