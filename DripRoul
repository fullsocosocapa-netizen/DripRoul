    local lower = string.lower(request)
    local subject = "valores militares"

    if string.find(lower, "cgm") then subject = "CGM"
    elseif string.find(lower, "general") or string.find(lower, "jinerais") then subject = "os Generais"
    elseif string.find(lower, "disciplina") then subject = "uma disciplina"
    elseif string.find(lower, "hierarquia") then subject = "a alta"
    elseif string.find(lower, "patente") or string.find(lower, "promoção") then subject = "uma patente"
    elseif string.find(lower, "anúncio") or string.find(lower, "anuncio") then subject = "anúncio"
