local function detectLines(r)
    local l = string.lower(r)
    if string.find(l, "1 linha") or string.find(l, "uma linha") then return 1 end
    if string.find(l, "2 linha") or string.find(l, "duas linha") or string.find(l, "menor") then return 2 end
    if string.find(l, "3 linha") or string.find(l, "três linha") or string.find(l, "tres linha") then return 3 end
    return 4
end

local function generateText(request)
