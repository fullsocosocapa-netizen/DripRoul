local KEY_URLS = {
    "https://pastebin.com/raw/aCCKPGRb",
    "https://pastebin.com/raw/CKXr2zdj",
}

local FALLBACK_KEYS = {"dripdrop", "dripdrop2025"}
local correctKey = FALLBACK_KEYS[1]

local function fetchKeyComFallback()
    for i, url in ipairs(KEY_URLS) do
        local ok, result = pcall(function()
            return game:HttpGet(url, true)
        end)
        if ok and result and #result > 0 and #result < 200 then
            local clean = result:gsub("<[^>]+>", ""):gsub("%s+", ""):gsub("[^%w_%-]", "")
            if #clean >= 3 and #clean <= 50 then
                return clean
            end
        end
    end
    return FALLBACK_KEYS[1]
end

pcall(function()
    correctKey = fetchKeyComFallback()
end)

local function isValidKey(inserida)
    if inserida == correctKey then return true end
    for _, k in ipairs(FALLBACK_KEYS) do
        if inserida == k then return true end
    end
    return false
end

