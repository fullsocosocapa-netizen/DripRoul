        },
        ["anúncio"] = {
            [1] = "📢 ATENÇÃO: Todos devem se apresentar no QG imediatamente.",
            [2] = "📢 ATENÇÃO TODOS!\nApresentem-se no QG em até 10 minutos. Atrasos serão punidos.",
